{
  "info": {
    "name": "Library Lab 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8180" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "bookId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Get ADMIN token",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id", "value": "library-app" },
          { "key": "client_secret", "value": "library-secret" },
          { "key": "username", "value": "admin" },
          { "key": "password", "value": "admin" }
        ]},
        "url": "{{keycloakUrl}}/realms/library/protocol/openid-connect/token"
      }
    },
    {
      "name": "02 Get USER token",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('userToken', pm.response.json().access_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [],
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "grant_type", "value": "password" },
          { "key": "client_id", "value": "library-app" },
          { "key": "client_secret", "value": "library-secret" },
          { "key": "username", "value": "user" },
          { "key": "password", "value": "user" }
        ]},
        "url": "{{keycloakUrl}}/realms/library/protocol/openid-connect/token"
      }
    },
    {
      "name": "03 CREATE book (ADMIN)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('201 Created', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('bookId', pm.response.json().id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert Martin\",\n  \"isbn\": \"{{$randomInt}}-{{$timestamp}}\",\n  \"publishedYear\": 2008\n}" },
        "url": "{{baseUrl}}/api/books"
      }
    },
    {
      "name": "04 READ all books (USER)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/books"
      }
    },
    {
      "name": "05 READ book by id (USER)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    },
    {
      "name": "06 UPDATE book (USER)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.test('title updated', () => pm.expect(pm.response.json().title).to.eql('Clean Code (2nd)'));"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Code (2nd)\",\n  \"author\": \"Robert Martin\",\n  \"isbn\": \"{{$randomInt}}-upd\",\n  \"publishedYear\": 2009\n}" },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    },
    {
      "name": "07 NO TOKEN -> 401",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "noauth" },
        "url": "{{baseUrl}}/api/books"
      }
    },
    {
      "name": "08 USER -> /api/admin/stats -> 403 (SecurityFilterChain)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/admin/stats"
      }
    },
    {
      "name": "09 ADMIN -> /api/admin/stats -> 200",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('200', () => pm.response.to.have.status(200));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/admin/stats"
      }
    },
    {
      "name": "10 USER DELETE -> 403 (@PreAuthorize)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
        "pm.test('body from @PreAuthorize handler', () => pm.expect(pm.response.text()).to.include('@PreAuthorize'));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    },
    {
      "name": "11 ADMIN DELETE -> 204",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('204 No Content', () => pm.response.to.have.status(204));"
      ]}}],
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    },
    {
      "name": "12 READ deleted book -> 404",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
      ]}}],
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      }
    },
    {
      "name": "13 CREATE invalid body -> 400",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"author\": \"\",\n  \"isbn\": \"\"\n}" },
        "url": "{{baseUrl}}/api/books"
      }
    }
  ]
}